{
  "manifest_version": 3,
  "name": "Setup Check",
  "version": "0.3.0",
  "description": "Checks that your microphone actually picks up sound, before you join a meeting.",
  "permissions": ["sidePanel", "nativeMessaging", "system.cpu", "system.memory"],
  "host_permissions": [
    "https://www.gstatic.com/*",
    "https://speed.cloudflare.com/*"
  ],
  "action": {
    "default_title": "Open Setup Check"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
